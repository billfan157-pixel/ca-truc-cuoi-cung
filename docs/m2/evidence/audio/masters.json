  "voiceTakes": {
    "sdk": "3.8.5",
    "modelRevision": "61b85e3d937fbbacb387714180e8182823512523",
    "takes": {
      "CH01-D01": {
        "role": "minh",
        "preset": "Thái Sơn",
        "spoken": "Chú Bảy bảo hoãn. Sao trong kia lại có đèn?",
        "precision": "fp32"
      },
      "CH01-D02": {
        "role": "minh",
        "preset": "Thái Sơn",
        "spoken": "Chỗ này đã đóng cửa từ lâu. Sao lại sáng đèn?",
        "precision": "fp32"
      },
      "CH01-D03": {
        "role": "lan",
        "preset": "Thục Đoan",
        "spoken": "Anh đến trễ rồi.",
        "precision": "fp32"
      },
      "CH01-D04": {
        "role": "minh",
        "preset": "Thái Sơn",
        "spoken": "Lan…? Không thể nào. Anh đã đến đám tang em.",
        "precision": "fp32"
      },
      "CH01-D05": {
        "role": "lan",
        "preset": "Thục Đoan",
        "spoken": "Anh xem giúp em phòng một linh một nhé. Mình nói chuyện sau.",
        "precision": "fp32"
      },
      "CH01-D06": {
        "role": "minh",
        "preset": "Thái Sơn",
        "spoken": "Anh đang nhìn nhầm thôi. Chỗ này đã đóng cửa lâu rồi.",
        "precision": "fp32"
      },
      "CH01-D07": {
        "role": "lan",
        "preset": "Thục Đoan",
        "spoken": "Kiểm tra trước khi ký, như hồi đó thôi.",
        "precision": "fp32"
      },
      "CH01-D08": {
        "role": "lan",
        "preset": "Thục Đoan",
        "spoken": "Có người gọi xê không một… À, anh cứ xem phòng một linh một trước.",
        "precision": "fp32"
      },
      "CH01-D09": {
        "role": "lan",
        "preset": "Thục Đoan",
        "spoken": "Em còn ca trực. Anh cứ kiểm tra phòng giúp em.",
        "precision": "fp32"
      },
      "CH01-D10": {
        "role": "minh",
        "preset": "Thái Sơn",
        "spoken": "Vậy là xong?",
        "precision": "int8"
      },
      "CH01-D11": {
        "role": "minh",
        "preset": "Thái Sơn",
        "spoken": "Chưa đủ căn cứ.",
        "precision": "fp32"
      },
      "CH01-D12": {
        "role": "minh",
        "preset": "Thái Sơn",
        "spoken": "Phiếu này không khớp.",
        "precision": "fp32"
      },
      "CH01-D13": {
        "role": "minh",
        "preset": "Thái Sơn",
        "spoken": "Lan? …Lan!",
        "precision": "fp32"
      },
      "CH01-D14": {
        "role": "minh",
        "preset": "Thái Sơn",
        "spoken": "Không thể nào. Mình vừa đi ra mà…",
        "precision": "fp32"
      },
      "CH01-D16": {
        "role": "lan",
        "preset": "Thục Đoan",
        "spoken": "Anh nhớ phần anh đã chứng kiến mà. Còn chuyện sau đó, anh đã nghe ai kể?",
        "precision": "fp32"
      },
      "CH02-D01": {
        "role": "minh",
        "preset": "Thái Sơn",
        "spoken": "Lan? Em nghe thấy anh không?",
        "precision": "fp32"
      },
      "CH02-D02": {
        "role": "minh",
        "preset": "Thái Sơn",
        "spoken": "Ba giường... nhưng có bốn chỗ cắm.",
        "precision": "fp32"
      },
      "CH02-D03": {
        "role": "an",
        "preset": "Ngọc Trân",
        "spoken": "Chú có thấy cửa nhà con không?",
        "precision": "fp32"
      },
      "CH02-D04": {
        "role": "minh",
        "preset": "Thái Sơn",
        "spoken": "An. Chú sẽ giữ lại cái tên này.",
        "precision": "fp32"
      },
      "CH02-D05": {
        "role": "gatekeeper",
        "preset": "Đức Trí",
        "spoken": "Phòng này không có bệnh nhân. Yêu cầu rời khỏi khu vực.",
        "precision": "fp32"
      },
      "CH01-PA01": {
        "role": "pa",
        "preset": "Minh Đức",
        "spoken": "Phòng một linh một. Đã xác nhận không còn bệnh nhân chưa bàn giao.",
        "precision": "int8"
      },
      "CH01-PA02": {
        "role": "pa",
        "preset": "Minh Đức",
        "spoken": "Phòng một linh một. Chờ… xác nhận.",
        "precision": "int8"
      },
      "CH01-PA03": {
        "role": "pa",
        "preset": "Minh Đức",
        "spoken": "Phòng một linh một. Yêu cầu kiểm tra lại.",
        "precision": "int8"
      },
      "CH01-PA04": {
        "role": "pa_cut",
        "preset": "Minh Đức",
        "spoken": "Đề nghị nhân viên hoàn tất ca…",
        "precision": "int8"
      }
    }
  },
